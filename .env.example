GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/auth/calendar/callback

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=YOUR_GMAIL_ADDRESS
EMAIL_PASSWORD=YOUR_16_CHARACTER_APP_PASSWORD