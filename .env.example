# ----- Environment -----
# "development" (default) or "production". Production refuses to start on a
# placeholder JWT secret, a localhost FRONTEND_URL, a SQLite DATABASE_URL, or
# missing email settings -- and stops serving /docs, /redoc and /openapi.json.
ENVIRONMENT=development

# ----- Required -----
# The application will not start without these.
OPENROUTER_API_KEY=your_openrouter_api_key
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters in production.
JWT_SECRET_KEY=your_jwt_secret_key

# ----- Auth -----
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT_ALGORITHM=HS256

# ----- Database -----
# Defaults to SQLite at the repository root. Required in production.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/workmind

# Connection pool, ignored on SQLite. The ceiling a deployment reaches is
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) x workers x instances; keep it under the
# database's max_connections.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ----- Rate limiting -----
# Unset means in-memory storage, which is per worker process -- the configured
# limits get multiplied by workers x instances. Required for more than one.
# REDIS_URL=redis://your-elasticache-endpoint:6379/0

# Number of proxies in front of the app, used to read the real client address
# from X-Forwarded-For. Behind a single ALB this is 1. Leave at 0 when nothing
# proxies the app: trusting the header without a proxy lets clients forge it.
# TRUSTED_PROXY_COUNT=0

# ----- GitHub -----
# In production the redirect URI must be https, point at the deployed backend,
# and be registered identically in the GitHub OAuth app. Validated at startup
# whenever GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are set.
GITHUB_ACCESS_TOKEN=your_github_access_token
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# ----- Google (Gmail + Calendar) -----
# Both redirect URIs must be registered under "Authorised redirect URIs" in
# the Google Cloud console. Google rejects plain http for web clients.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/auth/calendar/callback

# ----- Email / SMTP -----
# Gmail requires a 16-character App Password (not the account password), which
# needs 2-Step Verification enabled on the account.
# Required in production: verification and password-reset emails depend on it.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=YOUR_GMAIL_ADDRESS
EMAIL_PASSWORD=YOUR_16_CHARACTER_APP_PASSWORD
# Seconds to wait on the SMTP host before giving up.
# EMAIL_TIMEOUT=10

# ----- Frontend -----
# Sets the CORS origin AND the links inside verification and password-reset
# emails, so in production it must be the public frontend URL.
FRONTEND_URL=http://localhost:5173
